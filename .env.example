# ── Kora (test mode) ────────────────────────────────────────────────────────
# Kora dashboard → switch to Test mode → Settings → API Configuration.
KORA_SECRET_KEY=sk_test_replace_me
KORA_PUBLIC_KEY=pk_test_replace_me
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
# Public HTTPS URL Kora posts webhooks to. Locally: your ngrok static domain.
# Paste the same URL into Kora dashboard → Settings → API Configuration → Webhook URL.
KORA_WEBHOOK_URL=https://your-domain.ngrok-free.app/api/webhooks/kora

# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://procureai:procureai@localhost:5434/procureai
# Used only by the integration test suite.
DATABASE_URL_TEST=postgresql://procureai:procureai@localhost:5434/procureai_test

# ── AI (any OpenAI-compatible chat API) ────────────────────────────────────
# Leave AI_API_KEY empty to run on the deterministic fallback parser only.
# Gemini (free, aistudio.google.com):  AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  AI_MODEL=gemini-2.5-flash
# Groq   (free, console.groq.com):     AI_BASE_URL=https://api.groq.com/openai/v1                          AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# ── App ─────────────────────────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
# 32+ random bytes. Signs record URLs, buyer sessions; encrypts the handover code at rest.
RECORD_SIGNING_SECRET=replace_with_64_hex_chars
# Required to open /admin when DEMO_MODE=false.
ADMIN_TOKEN=

# ── Flags ───────────────────────────────────────────────────────────────────
DEMO_MODE=true
SIMULATE_IDENTITY=false
ENABLE_CHECKOUT_REDIRECT=false
LOG_LEVEL=info
